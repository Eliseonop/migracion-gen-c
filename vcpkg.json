{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "genclippro",
  "version": "0.1.0",
  "description": "Motor C++ multiplataforma de GenClipPro (migración de video-yt)",
  "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc",
  "vcpkg-configuration": {
    "overlay-ports": [ "./cmake/vcpkg-ports" ]
  },
  "dependencies": [
    "nlohmann-json",
    "spdlog"
  ],
  "features": {
    "tests": {
      "description": "Dependencias de los tests",
      "dependencies": [
        "catch2"
      ]
    },
    "media": {
      "description": "gc_media: FFmpeg LGPL (sin x264/x265) con los encoders por hardware, libvpx (VP9 con alfa), dav1d (AV1) y OpenH264 (H.264 por software sin GPL)",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec", "avformat", "avfilter", "swresample", "swscale", "zlib", "vpx", "dav1d", "openh264",
            { "name": "nvcodec", "platform": "windows | linux" },
            { "name": "amf", "platform": "windows" },
            { "name": "qsv", "platform": "windows" }
          ]
        }
      ]
    },
    "render": {
      "description": "gc_render: Skia por CPU (con las features por defecto: harfbuzz, icu, jpeg, png, webp, gl) y HarfBuzz para dar forma al texto",
      "dependencies": [
        "harfbuzz",
        "skia"
      ]
    }
  }
}
